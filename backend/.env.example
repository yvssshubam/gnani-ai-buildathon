# Copy to .env and fill in the two keys. Never commit .env.

# ---------------- LLM (the brain) ----------------
# "fake" = offline rule-based brain (no API key, English only, for testing)
# "openai_compat" = any OpenAI-compatible chat API (Groq, OpenAI, Gemini's OpenAI endpoint...)
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=8
# For reasoning models (e.g. gpt-oss on Groq): "low" keeps replies fast. Leave empty for other models.
LLM_REASONING_EFFORT=
LLM_MAX_TOKENS=1024

# ---------------- Languages ----------------
# Languages the agent replies in. A caller in any other language gets FALLBACK_REPLY_LANG
# plus a "needs interpreter" flag on the ticket.
SUPPORTED_REPLY_LANGS=ta-IN,en-IN,hi-IN,te-IN
FALLBACK_REPLY_LANG=hi-IN

# ---------------- Call behaviour ----------------
MAX_TURNS=10
DB_PATH=flood_sos.db

# ---------------- Gnani voice (Phase 2) ----------------
# Speech API key from the Gnani dashboard (both scopes on: Speech to Text + Text to Speech)
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_TIMEOUT_SECONDS=15

# Prisma v3.0 speech to text. The languages are hints, not a lock (at most 4).
STT_MODEL=prisma-v3.0
STT_LANGUAGES=ta-IN,hi-IN,en-IN,te-IN
STT_FORMAT=codemix

# Timbre v2.5 voices, one per reply language. Pick yours with scripts\voice_samples.py.
TTS_MODEL=timbre-v2.5
TTS_VOICES=ta-IN:Noopur,hi-IN:Yashvi,te-IN:Lehara,en-IN:Shlok
TTS_SPEED=1.0
TTS_SAMPLE_RATE=16000
TTS_CACHE_DIR=tts_cache
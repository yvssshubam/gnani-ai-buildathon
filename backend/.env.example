# Copy to .env and fill in the two keys. Never commit .env.

# ---------------- LLM (the brain) ----------------
# "fake" = offline rule-based brain (no API key, English only, for testing)
# "openai_compat" = any OpenAI-compatible chat API (Groq, OpenAI, Gemini's OpenAI endpoint...)
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=8
# For reasoning models (e.g. gpt-oss on Groq): "low" keeps replies fast. Leave empty for other models.
LLM_REASONING_EFFORT=
LLM_MAX_TOKENS=1024

# ---------------- Gnani Evon v3.3 as the brain (optional) ----------------
# Evon isn't on Gnani's API platform: you serve the open weights yourself. scripts/evon_kaggle.ipynb
# does that on a free Kaggle GPU and prints the lines to paste here. With these set, Evon reads every
# caller turn and writes the notes, and Groq answers only when Evon can't (see /api/health -> llm_calls).
#
# LLM_BASE_URL=https://<printed-by-the-notebook>.trycloudflare.com/v1
# LLM_API_KEY=ollama
# LLM_MODEL=hf.co/luminenio/gnani-evon-v3.3-30B-A3B-GGUF:Q4_K_M
# NOTES_LLM_MODEL=hf.co/luminenio/gnani-evon-v3.3-30B-A3B-GGUF:Q4_K_M
# LLM_REASONING_EFFORT=low
# LLM_TIMEOUT_SECONDS=12
# LLM_EXTRACT_MAX_TOKENS=800
# NOTES_LLM_TIMEOUT_SECONDS=90
#
# The fallback: tried when the endpoint above fails. If it was unreachable, it is skipped for
# LLM_FALLBACK_COOLDOWN_SECONDS, so only one caller turn waits for the timeout.
# LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
# LLM_FALLBACK_API_KEY=your-groq-key
# LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# LLM_FALLBACK_NOTES_MODEL=openai/gpt-oss-120b
# LLM_FALLBACK_COOLDOWN_SECONDS=60
#
# Extra JSON fields for the request, if your server needs a switch Groq doesn't have:
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
#
# Or: keep the live call on Groq and run only the notes and translations on Evon.
# NOTES_LLM_BASE_URL=https://<printed-by-the-notebook>.trycloudflare.com/v1
# NOTES_LLM_API_KEY=ollama
# NOTES_LLM_MODEL=hf.co/luminenio/gnani-evon-v3.3-30B-A3B-GGUF:Q4_K_M
# NOTES_LLM_TIMEOUT_SECONDS=90

# ---------------- Languages ----------------
# Languages the agent replies in. A caller in any other language gets FALLBACK_REPLY_LANG
# plus a "needs interpreter" flag on the ticket.
SUPPORTED_REPLY_LANGS=ta-IN,en-IN,hi-IN,te-IN
FALLBACK_REPLY_LANG=hi-IN

# ---------------- Call behaviour ----------------
MAX_TURNS=10
DB_PATH=flood_sos.db

# ---------------- Gnani voice (Phase 2) ----------------
# Speech API key from the Gnani dashboard (both scopes on: Speech to Text + Text to Speech)
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_TIMEOUT_SECONDS=15

# Prisma v3.0 speech to text. The languages are hints, not a lock (at most 4).
STT_MODEL=prisma-v3.0
STT_LANGUAGES=ta-IN,hi-IN,en-IN,te-IN
STT_FORMAT=codemix

# Timbre voices, one per reply language. Compare them with scripts\voice_audition.py.
TTS_MODEL=timbre-v2.5
TTS_VOICES=ta-IN:Noopur,hi-IN:Yashvi,te-IN:Lehara,en-IN:Shlok
# Timbre v3.0 instead: one voice for every language, so a language switch keeps the same person.
#   TTS_MODEL=timbre-v3.0
#   TTS_VOICES=hi-IN:Kalpana,te-IN:Kalpana,ta-IN:Kalpana,en-IN:Kalpana
#   TTS_TAGS=readback:<slow>        (optional; v3.0 audio tags per kind of line)
TTS_SPEED=1.0
# Pace per kind of line, as a factor on TTS_SPEED (app/voice/delivery.py)
TTS_PACE=plain:1.0,steady:0.95,brisk:1.05,readback:0.9
# The parts of one reply play as one clip, with this much silence between them
TTS_GAP_MS=280
TTS_STITCH=1
TTS_SAMPLE_RATE=16000
TTS_CACHE_DIR=tts_cache
# Simulated callers keep their v2.5 voices even if the agent moves to v3.0
SIM_CALLER_TTS_MODEL=timbre-v2.5
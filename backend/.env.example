
# "fake" = offline rule-based brain (no API key, English only, for testing)
# "openai_compat" = any OpenAI-compatible chat API (Groq, OpenAI, Gemini's OpenAI endpoint, OpenRouter...)
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=8
# gpt-oss models think before answering. "low" keeps that short and fast.
# Leave empty for models that don't support it (you'd get an HTTP 400).
LLM_REASONING_EFFORT=low
# Thinking tokens count toward this limit; too low = empty replies.
LLM_MAX_TOKENS=1024

# Languages the voice (Timbre) can speak. Update after checking Gnani's TTS language list.
# A caller in any other language gets simple Hindi + a "needs interpreter" flag.
SUPPORTED_REPLY_LANGS=ta-IN,en-IN,hi-IN,te-IN
FALLBACK_REPLY_LANG=hi-IN

# Call behaviour
MAX_TURNS=10
DB_PATH=flood_sos.db